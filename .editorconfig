root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.{sh,bash}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false

[*.{prop,conf}]
indent_size = 4

[*.{c,cc,cpp,h,hpp}]
indent_size = 2

[*.java]
indent_size = 2

[*.py]
indent_size = 4
