    "captureWarning": {
      "banner": "Enabling module umount for Reqable, ProxyPin, or the target app removes the cacerts mount and often reports the root CA missing.",
      "notice": "Umount modules, DenyList+umount, or APatch Exclude Modifications removes the cacerts mount from capture apps.",
      "toolLabel": "Capture app",
      "toolText": "umount enabled → root CA often appears missing",
      "targetLabel": "Target app",
      "targetText": "umount enabled → TLS cannot see the capture CA",
      "scope": "Only hide apps that need it and are not in this capture path.",
      "force": "If umount must stay on, Force-bind apps may restore the CA but weakens hiding."
    },
    "checklistNotice": "Capture-path apps must see the cacerts mount.",
    "checklistItems": [
      "Disable Umount modules / Exclude Modifications for Reqable and ProxyPin.",
      "Disable the same hiding for the app being captured.",
      "Enable umount only for other apps that need detection hiding.",
      "For maps filtering, custom-install the Zygisk filter and enable Zygisk."
    ],
    "guideSections": {
      "capture": {
        "title": "Capture rule: do not umount capture apps",
        "body": [
          "A process must see the cacerts bind for the CA to work. Module umount, DenyList+Shamiko umount, or APatch exclusion removes that mount.",
          "Do not enable those options for Reqable or ProxyPin, or they may report the root CA missing.",
          "Do not enable them for the target app either, or TLS may fail with network or certificate errors.",
          "Use app-specific umount only for other apps that need Root or mount hiding.",
          "hide_allow registers cacerts globally with SuSFS, ksud, or NoHello; your per-app umount list still decides where it is removed.",
          "If a capture app must use umount, Labs → Force-bind apps can rebind it, but weakens hiding and is for debugging.",
          "If some apps still miss the CA, Labs → Late inject retries app namespaces after boot, with extra traces.",
          "For Found KSU reports, try disabling Boot Zygote or Full boot targets; compatibility may drop and a reboot is required."
        ]
      },
      "magisk": {
        "title": "Magisk / Alpha / Kitsune",
        "body": [
          "DenyList replaces old MagiskHide. Add only apps that need Root hiding.",
          "Enforce DenyList mainly blocks Zygisk modules; it is not full bind-mount hiding and usually stays off with Shamiko or NoHello.",
          "Keep Reqable, ProxyPin, and capture targets out of umount-enabled lists.",
          "Recommended: ZygiskNext or ReZygisk + NoHello. hide_allow registers cacerts point rules; the app list controls umount.",
          "Official Magisk has no path-level umount registration API."
        ]
      },
      "ksu": {
        "title": "KernelSU / SukiSU / MKSU",
        "body": [
          "Enable Umount modules only for apps that need hiding, and use a kernel with path_umount support.",
          "Disable it for Reqable, ProxyPin, and capture targets.",
          "With SuSFS and hide_allow, CertBridge registers cacerts with add_try_umount after a successful bind.",
          "NeoZygisk, ReZygisk, or ZygiskNext umount-only can be combined, but not for capture-path apps.",
          "Avoid conflicting overlay modules such as Magical OverlayFS."
        ]
      },
      "apatch": {
        "title": "APatch",
        "body": [
          "Use Exclude Modifications only for apps that need hiding.",
          "Do not exclude Reqable, ProxyPin, or capture targets, or they cannot see the CA mount.",
          "apd has no ksud-style path API. Use ZygiskNext/ReZygisk + NoHello; hide_allow registers point rules."
        ]
      },
      "limits": {
        "title": "Limits",
        "body": [
          "The default /dev/.fs* staging path avoids simple /data/local/tmp scans but does not replace umount.",
          "Without SuSFS or a Zygisk umount helper, mountinfo checks may still find the bind.",
          "The optional Zygisk filter hides matching mount/maps lines and module readlinks; in-memory code and the Zygisk loader may remain detectable.",
          "Reqable and ProxyPin are filter-whitelisted so they retain the CA view.",
          "The default install omits the Zygisk filter; select it in custom install and include zygisk/*.so.",
          "System TLS requires the CA in a trust-store path; there is no general mount-free CA injection."
        ]
      }
    }
  },
