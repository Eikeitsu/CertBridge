{
  "name": "certbridge",
  "private": true,
  "version": "4.3.1",
  "type": "module",
  "scripts": {
    "prepare": "husky",
    "dev:web": "vite --config webui/vite.config.ts",
    "build:web": "node scripts/build-web.mjs",
    "lint:js": "eslint webui scripts docs/.vitepress eslint.config.js stylelint.config.js commitlint.config.js --max-warnings 0",
    "lint:js:fix": "npm run lint:js -- --fix",
    "lint:style": "stylelint \"webui/**/*.{scss,css}\" --allow-empty-input",
    "lint:style:fix": "npm run lint:style -- --fix",
    "lint:md": "markdownlint-cli2",
    "lint:shell": "node scripts/lint-shell.mjs",
    "lint:py": "node scripts/lint-py.mjs",
    "lint:py:fix": "node scripts/lint-py.mjs --fix",
    "lint:java": "node scripts/lint-java.mjs",
    "lint:java:fix": "node scripts/lint-java.mjs --fix",
    "lint:clang": "node scripts/lint-clang.mjs",
    "lint:clang:fix": "node scripts/lint-clang.mjs --fix",
    "lint:commit": "commitlint --from HEAD~1 --to HEAD --verbose",
    "lint": "npm run lint:js && npm run lint:style && npm run lint:md && npm run lint:shell && npm run lint:py && npm run lint:java && npm run lint:clang",
    "lint:fix": "npm run lint:js:fix && npm run lint:style:fix && npm run lint:py:fix && npm run lint:java:fix && npm run lint:clang:fix",
    "format": "prettier --write \"webui/**/*.{ts,tsx,scss,css,json,html,md}\" \"scripts/**/*.{mjs,md,js}\" \"docs-dev/**/*.md\" \"docs/**/*.{md,mjs}\" \"*.{md,json,yml,js,cjs,mjs}\" \".github/**/*.{yml,yaml}\" \".markdownlint-cli2.jsonc\" \".lintstagedrc.json\" \".prettierrc\"",
    "format:check": "prettier --check \"webui/**/*.{ts,tsx,scss,css,json,html,md}\" \"scripts/**/*.{mjs,md,js}\" \"docs-dev/**/*.md\" \"docs/**/*.{md,mjs}\" \"*.{md,json,yml,js,cjs,mjs}\" \".github/**/*.{yml,yaml}\" \".markdownlint-cli2.jsonc\" \".lintstagedrc.json\" \".prettierrc\"",
    "format:all": "npm run format && npm run lint:fix",
    "check": "npm run typecheck:web && npm run lint && npm run format:check",
    "build:cbx509": "node scripts/build-cbx509.mjs",
    "i18n:gen": "node scripts/i18n/gen-shell-catalog.mjs",
    "package:module": "npm run i18n:gen && node scripts/package-module.mjs",
    "build:zygisk-hide": "node scripts/build-zygisk-hide.mjs",
    "build:module": "npm run build:web && npm run build:zygisk-hide && npm run package:module",
    "dev:docs": "vitepress dev docs",
    "build:docs": "vitepress build docs",
    "preview:docs": "vitepress preview docs",
    "typecheck:web": "tsc --noEmit -p webui/tsconfig.json"
  },
  "dependencies": {
    "@radix-ui/react-collapsible": "^1.1.20",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-switch": "^1.3.7",
    "@reduxjs/toolkit": "^2.6.1",
    "i18next": "^26.4.2",
    "lucide-react": "^1.46.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-i18next": "^17.0.15",
    "react-redux": "^9.2.0",
    "react-router-dom": "^6.30.0"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.8.0",
    "@commitlint/config-conventional": "^19.8.0",
    "@eslint/js": "^9.22.0",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "clean-css": "^5.3.3",
    "eslint": "^9.22.0",
    "eslint-plugin-react": "^7.37.4",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^16.0.0",
    "html-minifier-terser": "^7.2.0",
    "husky": "^9.1.7",
    "lint-staged": "^15.5.0",
    "markdownlint-cli2": "^0.17.2",
    "prettier": "^3.5.3",
    "sass": "^1.85.1",
    "serve": "^14.2.4",
    "stylelint": "^16.16.0",
    "stylelint-config-standard-scss": "^14.0.0",
    "terser": "^5.39.0",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.26.1",
    "vite": "^6.2.2",
    "vitepress": "^1.6.3",
    "yazl": "^3.3.1"
  }
}
