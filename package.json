{
  "name": "certbridge",
  "private": true,
  "version": "2.2.1",
  "type": "module",
  "scripts": {
    "prepare": "husky",
    "dev:web": "vite --config webui/vite.config.ts",
    "build:web": "node tooling/scripts/build-web.mjs",
    "typecheck:web": "tsc --noEmit -p webui/tsconfig.json",
    "lint:js": "eslint webui tooling docs/.vitepress eslint.config.js stylelint.config.js commitlint.config.js --max-warnings 0",
    "lint:js:fix": "npm run lint:js -- --fix",
    "lint:style": "stylelint \"webui/**/*.{scss,css}\" --allow-empty-input",
    "lint:style:fix": "npm run lint:style -- --fix",
    "lint:md": "markdownlint-cli2",
    "lint:shell": "node tooling/scripts/lint-shell.mjs",
    "lint:commit": "commitlint --from HEAD~1 --to HEAD --verbose",
    "lint": "npm run lint:js && npm run lint:style && npm run lint:md && npm run lint:shell",
    "lint:fix": "npm run lint:js:fix && npm run lint:style:fix",
    "format": "prettier --write \"webui/**/*.{ts,tsx,scss,css,json,html,md}\" \"tooling/**/*.{mjs,md,js}\" \"docs/**/*.{md,mjs}\" \"*.{md,json,yml,js,cjs,mjs}\" \".github/**/*.{yml,yaml}\"",
    "format:check": "prettier --check \"webui/**/*.{ts,tsx,scss,css,json,html,md}\" \"tooling/**/*.{mjs,md,js}\" \"docs/**/*.{md,mjs}\" \"*.{md,json,yml,js,cjs,mjs}\" \".github/**/*.{yml,yaml}\"",
    "check": "npm run typecheck:web && npm run lint && npm run format:check",
    "build:cbx509": "node tooling/scripts/build-cbx509.mjs",
    "package:module": "node tooling/scripts/package-module.mjs",
    "build:module": "npm run build:web && npm run package:module",
    "dev:docs": "vitepress dev docs",
    "build:docs": "vitepress build docs",
    "preview:docs": "vitepress preview docs"
  },
  "dependencies": {
    "@reduxjs/toolkit": "^2.6.1",
    "antd-mobile": "^5.42.3",
    "antd-mobile-icons": "^0.3.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-redux": "^9.2.0",
    "react-router-dom": "^6.30.0"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.8.0",
    "@commitlint/config-conventional": "^19.8.0",
    "@eslint/js": "^9.22.0",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "eslint": "^9.22.0",
    "eslint-plugin-react": "^7.37.4",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^16.0.0",
    "husky": "^9.1.7",
    "lint-staged": "^15.5.0",
    "markdownlint-cli2": "^0.17.2",
    "prettier": "^3.5.3",
    "sass": "^1.85.1",
    "stylelint": "^16.16.0",
    "stylelint-config-standard-scss": "^14.0.0",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.26.1",
    "vite": "^6.2.2",
    "vitepress": "^1.6.3",
    "yazl": "^3.3.1"
  }
}
